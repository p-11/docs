{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Strongpoint",
  "colors": {
    "primary": "#327681",
    "light": "#A6F3FF",
    "dark": "#002234"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Getting started",
        "pages": [
          "getting-started/basics",
          "getting-started/setup"
        ]
      },
      {
        "group": "Portfolio",
        "pages": [
          "portfolio/accounts",
          "portfolio/wallets",
          "portfolio/addresses",
          "portfolio/sending-and-receiving"
        ]
      },
      {
        "group": "Organisation",
        "pages": [
          "organisation/users",
          "organisation/roles-and-permissions"
        ]
      },
      {
        "group": "Policies & Approvals",
        "pages": [
          "policies-and-approvals/ios-authenticator",
          "policies-and-approvals/quorums",
          "policies-and-approvals/policies"
        ]
      },
      {
        "group": "KMS",
        "pages": [
          "kms/keyrings",
          "kms/keys",
          "kms/key-versions",
          "kms/providers"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/changelog",
          "reference/peak"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@projecteleven.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://strongpoint.projecteleven.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#101014"
    }
  },
  "fonts": {
    "family": "Geist"
  }
}
