{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Strongpoint",
  "colors": {
    "primary": "#327681",
    "light": "#A6F3FF",
    "dark": "#002234"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Getting started",
        "pages": [
          "getting-started/basics",
          {
            "group": "Onboarding",
            "pages": [
              "onboarding",
              "onboarding/accept-invite",
              "onboarding/enroll-iphone",
              "onboarding/log-in",
              "onboarding/invite-users",
              "onboarding/create-account"
            ]
          }
        ]
      },
      {
        "group": "Portfolio",
        "pages": [
          "portfolio/overview",
          "portfolio/receive-funds",
          "portfolio/send-funds",
          "portfolio/add-wallet",
          "portfolio/manage-account",
          "portfolio/address-book",
          {
            "group": "Reference",
            "pages": [
              "portfolio/transfer-statuses",
              "portfolio/supported-networks"
            ]
          }
        ]
      },
      {
        "group": "Organization",
        "pages": [
          "organisation/users",
          "organisation/send-device-enrollment",
          "organisation/roles-and-permissions"
        ]
      },
      {
        "group": "Approvals",
        "pages": [
          "policies-and-approvals/approvals",
          "policies-and-approvals/approve-request",
          "policies-and-approvals/track-requests",
          "policies-and-approvals/cancel-request",
          {
            "group": "Reference",
            "pages": [
              "policies-and-approvals/request-statuses",
              "policies-and-approvals/quorums"
            ]
          }
        ]
      },
      {
        "group": "Policies",
        "pages": [
          "policies-and-approvals/policies",
          "policies-and-approvals/change-policy"
        ]
      },
      {
        "group": "Signing keys",
        "pages": [
          "kms/overview",
          "kms/create-key-ring",
          "kms/add-key",
          "kms/sign-payload",
          "kms/rotate-key",
          "kms/disable-or-delete-key",
          {
            "group": "Reference",
            "pages": [
              "kms/algorithms-and-providers",
              "kms/key-states"
            ]
          }
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/changelog",
          "reference/peak"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@projecteleven.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://strongpoint.projecteleven.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#101014"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "redirects": [
    {
      "source": "/policies-and-approvals/ios-authenticator",
      "destination": "/policies-and-approvals/approve-request"
    },
    {
      "source": "/portfolio/accounts",
      "destination": "/portfolio/overview"
    },
    {
      "source": "/portfolio/wallets",
      "destination": "/portfolio/add-wallet"
    },
    {
      "source": "/portfolio/addresses",
      "destination": "/portfolio/receive-funds"
    },
    {
      "source": "/portfolio/sending-and-receiving",
      "destination": "/portfolio/send-funds"
    },
    {
      "source": "/kms/keyrings",
      "destination": "/kms/overview"
    },
    {
      "source": "/kms/keys",
      "destination": "/kms/overview"
    },
    {
      "source": "/kms/key-versions",
      "destination": "/kms/rotate-key"
    },
    {
      "source": "/kms/providers",
      "destination": "/kms/algorithms-and-providers"
    }
  ]
}
